<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="450dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_white_bg"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/dialogAlertIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_dialog_alert"
        android:contentDescription="warning icon" />

    <TextView
        android:id="@+id/dialogAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="함께 두면 위험한 시약"
        android:textColor="#ED5565"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogAlertMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="황산 0.1M은 인접 수납칸의 시안화칼륨과 반응 위험이 있습니다.\n안전한 보관 위치를 다시 안내해드릴게요."
        android:textColor="#44507E"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2" />

    <TextView
        android:id="@+id/dialogAlertSubText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#8B97BE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gap="12dp">

        <Button
            android:id="@+id/btnAlertNegative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="무시하고 보관"
            android:backgroundTint="#8B97BE"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAlertPositive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="안전 위치 안내"
            android:backgroundTint="#3D6BF5"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
