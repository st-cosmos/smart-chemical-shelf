<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F2F5FF"
    android:padding="32dp">

    <!-- Profile Selection Section (Left Side) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Shelf"
            android:textColor="#3D6BF5"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="프로필을 선택하여 로그인을 진행해 주세요 (스크롤 가능)"
            android:textColor="#8B97BE"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profilesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#E1E8F8"
        android:layout_marginHorizontal="24dp" />

    <!-- PIN Pad Section (Right Side) -->
    <LinearLayout
        android:id="@+id/pinSection"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="invisible"
        android:padding="16dp">

        <TextView
            android:id="@+id/pinTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="김연구 님의 PIN 입력"
            android:textColor="#1E2A56"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinDotsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="○ ○ ○ ○"
            android:textColor="#3D6BF5"
            android:textSize="32sp"
            android:letterSpacing="0.2"
            android:textStyle="bold" />

        <!-- Numeric Keypad -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:columnCount="3"
            android:rowCount="4">

            <Button android:id="@+id/btn1" android:text="1" style="@style/PinPadButton" />
            <Button android:id="@+id/btn2" android:text="2" style="@style/PinPadButton" />
            <Button android:id="@+id/btn3" android:text="3" style="@style/PinPadButton" />
            
            <Button android:id="@+id/btn4" android:text="4" style="@style/PinPadButton" />
            <Button android:id="@+id/btn5" android:text="5" style="@style/PinPadButton" />
            <Button android:id="@+id/btn6" android:text="6" style="@style/PinPadButton" />
            
            <Button android:id="@+id/btn7" android:text="7" style="@style/PinPadButton" />
            <Button android:id="@+id/btn8" android:text="8" style="@style/PinPadButton" />
            <Button android:id="@+id/btn9" android:text="9" style="@style/PinPadButton" />

            <Button android:id="@+id/btnClear" android:text="C" style="@style/PinPadButton" android:textColor="#ED5565" />
            <Button android:id="@+id/btn0" android:text="0" style="@style/PinPadButton" />
            <Button android:id="@+id/btnBack" android:text="⌫" style="@style/PinPadButton" />
        </GridLayout>

        <Button
            android:id="@+id/btnBackToProfiles"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="돌아가기"
            android:backgroundTint="#8B97BE"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
