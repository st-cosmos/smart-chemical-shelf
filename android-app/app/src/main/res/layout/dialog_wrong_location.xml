<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="450dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_white_bg"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_dialog_alert"
        android:contentDescription="warning icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="잘못된 위치에 놓였습니다"
        android:textColor="#ED5565"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogWarningMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="에탄올 95%의 지정 위치는 선반 A · 2행 3열입니다.\n현재 선반 B · 1행 2열에 안착이 감지되었습니다."
        android:textColor="#44507E"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gap="12dp">

        <Button
            android:id="@+id/btnMoveToDesignated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="지정 위치로 옮기기"
            android:backgroundTint="#8B97BE"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnUpdateLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="이 위치로 수정하기"
            android:backgroundTint="#3D6BF5"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
