<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F5FF">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 홈으로"
            android:textColor="#3D6BF5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="시약 반입"
            android:textColor="#1E2A56"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gap="24dp">

        <!-- Camera Section (Left) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginEnd="12dp"
            android:background="#1A2138">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Target Box Overlay -->
            <View
                android:layout_width="320dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/camera_target_border" />

            <TextView
                android:id="@+id/scanStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="#80000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="시약통 라벨을 프레임 안에 맞춰주세요"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:round="999dp" />
        </FrameLayout>

        <!-- Details Section (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_white_bg"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인식 결과"
                    android:textColor="#8B97BE"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Scan state views -->
                <LinearLayout
                    android:id="@+id/scanResultEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    
                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="카메라로 시약 라벨을 스캔하는 중..."
                        android:textColor="#8B97BE"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scanResultActive"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/scannedChemicalName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="에탄올 95% (EtOH)"
                        android:textColor="#1E2A56"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scannedHistoryType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="기존 보유 시약 · 재반입"
                        android:textColor="#3D6BF5"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scannedLocationDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="지정 위치 : 선반 A · 2행 3열 — LED 점등됨"
                        android:textColor="#44507E"
                        android:textSize="15sp" />

                    <!-- Placement status graphic -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginTop="24dp">

                        <ImageView
                            android:id="@+id/placementStatusIcon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@android:drawable/ic_menu_myplaces" />

                        <TextView
                            android:id="@+id/placementStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="시약을 선반의 지정된 위치에 내려놓아 주세요"
                            android:textColor="#8B97BE"
                            android:textSize="13sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnCancelSession"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="스캔 취소"
                        android:backgroundTint="#ED5565"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navCheckin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시약 반입"
                android:textColor="#3D6BF5"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCheckout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시약 반출"
                android:textColor="#8B97BE"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navShelf"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="선반 관리"
                android:textColor="#8B97BE"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
